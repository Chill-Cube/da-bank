[sub_resource type="GDScript" id="GDScript_nujy2"]
script/source = "extends ProgressBar

@onready var string: String = get_node(\"Label\").text
var val := 0.0

var ranks := [0, 370, 740, 1110, 1480, 1850]
var grades := [\"F\", \"D\", \"C\", \"B\", \"A\", \"S\"]
var rank := 0
var winser := false

var time := 0.0
var update_delay := 0.0

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	if time >= update_delay:
		update_delay = 0.0
		time = 0.0

		if val < GlobalVariables.money:
			val += 10.0
		if val >= GlobalVariables.money:
			val = GlobalVariables.money
		get_node(\"Label\").text = string % [val,ranks[clamp(rank,0,ranks.size()-1)]]
		%Rank.text = \"RANK: \" + grades[clamp(rank, 0, grades.size()-1)]
		value = val
		max_value = lerp(max_value,float(ranks[clamp(rank,0,ranks.size()-1)]),0.1)
		if rank >= ranks.size() - 1 and val >= ranks[rank] and !winser:
			winser = true
		if !winser:
			if rank < ranks.size() - 1 and val >= ranks[rank + 1]:
				rank += 1
				update_delay = 1.0
	time += delta
"

